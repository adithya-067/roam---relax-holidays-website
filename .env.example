# =================================================================
# Roam & Relax Holidays - Environment Configuration
# =================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to git.

# ---------------------------------------------------------------
# 1. Supabase Credentials
#    Get these from: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------

# Your project URL (shown at the top of the API settings page)
SUPABASE_URL=https://your-project-id.supabase.co

# service_role SECRET key — used ONLY in server-side API routes.
# This key bypasses RLS and must NEVER be exposed to the browser.
# Find it under: Project Settings → API → "service_role" → secret
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-key-here

# anon/publishable key — for future client-side Supabase usage (optional here)
SUPABASE_ANON_KEY=sb_publishable_your-key-here

# ---------------------------------------------------------------
# 2. Resend API Credentials (Transactional Email Notifications)
#    Get your API key from: https://resend.com/api-keys
# ---------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# Business email that receives new enquiry notifications
BUSINESS_EMAIL=bookings@roamandrelaxholidays.com

# Verified sender address in Resend (must match a verified domain in production)
RESEND_FROM_EMAIL=Roam & Relax Enquiries <onboarding@resend.dev>
